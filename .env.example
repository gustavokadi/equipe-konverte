# Copie para .env e preencha só o que for usar.
# O plano grátis funciona sem nenhuma chave.

# Opcional: fotos de banco no carrossel. Sem chave, o slide fica gráfico.
# Termos em TERCEIROS.md. O crédito vai para referencias/banco/creditos.md.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Pago Plus, pago. A v1 não chama esta API. Ver TERCEIROS.md.
# FREEPIK_API_KEY=

# Opcional: radar com Firecrawl. Sem a chave, o /radar usa RSS público.
# Não embutimos o código do Firecrawl (licença AGPL). É chamada de API, à parte.
FIRECRAWL_API_KEY=

# Plano Pago Plus. Sem as chaves, o /roteiro-clone só gera o texto.
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=

# Deploy do /site. O script nunca publica se o token não existir.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NETLIFY_AUTH_TOKEN=
